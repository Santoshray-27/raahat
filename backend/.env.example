# RAAHAT Core Backend Environment Template

# Database
# PostgreSQL is the required database for RAAHAT.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/raahat

# Google APIs
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_JS_KEY=

# Geoapify fallback
GEOAPIFY_API_KEY=

# Gemini
GEMINI_API_KEY=

# Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-key.json

# Authentication
AUTH_DISABLED=true